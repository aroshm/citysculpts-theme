{% comment %}
  Dynamic Cities Menu
  - Loops through All Cities collection
  - Groups by region metafield
  - Lists city products under each region
{% endcomment %}

<div class="cities-list-wrapper">
  <div class="cities-list">
    <p class="city-region">North America</p>
    <ul>
      {%- for product in collections['all-cities'].products -%}
        {%- if product.metafields.custom.country_region1 == "North America" -%}
          <li>
            <a href="{{ product.url }}">{{ product.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
