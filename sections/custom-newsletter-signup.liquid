

{% style %}
  .ai-newsletter-signup {
    display: block;
    margin-bottom: {{ section.settings.padding_bottom }}px;
    margin-top: {{section.settings.padding_top}}px;
    padding: 0;
    width: 100%;
  }

  .ai-newsletter-signup__container {
    background-color: {{ section.settings.background_color }};
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    gap: 30px;
    padding: 50px 70px 50px;
    flex-direction: column;
  }

  @media (min-width: 992px) {
    .ai-newsletter-signup__container {
      flex-direction: row;
      padding-top: 140px;
    }
  }

  .ai-newsletter-signup__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-newsletter-signup__heading {
    font-family: 'Canela-regular';
    font-size: 23px;
    font-weight: unset;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  @media (min-width: 768px) {
    .ai-newsletter-signup__heading {
      font-size: 35px;
    }
  }

  @media (min-width: 1200px) {
    .ai-newsletter-signup__heading {
      font-size: 43px;
    }
  }

  .ai-newsletter-signup__heading p {
    margin: 0;
  }

  .ai-newsletter-signup__description {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    margin: 0;
    opacity: 0.9;
    max-width: 612px;
  }

  .ai-newsletter-signup__form-wrapper {
    margin-top: 155px;
  }

  .ai-newsletter-signup__form-container {
    display: flex;
    gap: 0;
    max-width: 650px;
  }

  .ai-newsletter-signup__input {
    flex: 1;
    padding: 10px;
    border: 0 none;
    border-bottom: 1px solid {{ section.settings.input_border_color }};
    border-right: none;
    border-radius: 0;
    font-family: 'Canela-light';
    font-size: 16px;
    background-color: {{ section.settings.input_background_color }};
    color: {{ section.settings.input_text_color }};
    outline: none;
  }

  .ai-newsletter-signup__input:focus {
    border-color: {{ section.settings.input_focus_border_color }};
  }

  .ai-newsletter-signup__input::placeholder {
    color: {{ section.settings.placeholder_color }};
  }

  .ai-newsletter-signup__button {
    padding: 12px 24px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    border: 0 none;
    border-bottom: 1px solid {{ section.settings.input_border_color }};
    border-radius: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-newsletter-signup__button:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  .ai-newsletter-signup__button-icon {
    align-items: center;
    display: flex;
    height: 36px;
    width: 36px;
  }

  .ai-newsletter-signup__button-icon svg {
    width: 100%;
  }

  .ai-newsletter-signup__logo-wrapper {
    flex-shrink: 0;
    width: {{ section.settings.logo_width_desktop }}px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    order: -1;
  }

  @media (min-width: 992px) {
    .ai-newsletter-signup__logo-wrapper {
      order: 1;
    }
  }

  .ai-newsletter-signup__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-newsletter-signup__logo-placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;position: relative;
  }

  .ai-newsletter-signup__logo-placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.4;
    color: #999;
  }

  .ai-newsletter-signup__empty-state {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-newsletter-signup__success {
    color: {{ section.settings.success_color }};
    font-size: 14px;
    margin-top: 8px;
  }

  .ai-newsletter-signup__error {
    color: {{ section.settings.error_color }};
    font-size: 14px;
    margin-top: 8px;
  }

  @media screen and (max-width: 768px) {
    .ai-newsletter-signup {
      padding: 15px;
    }

    .ai-newsletter-signup__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .ai-newsletter-signup__description {
      font-size: {{ section.settings.body_size_mobile }}px;
    }

    .ai-newsletter-signup__form-container {
      max-width: 100%;
    }
  }
{% endstyle %}<newsletter-signup
  class="ai-newsletter-signup"
  {{ section.shopify_attributes }}
>
  <div class="ai-newsletter-signup__container">
    <div class="ai-newsletter-signup__content">
      {% if section.settings.heading != blank %}
        <h2 class="ai-newsletter-signup__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ai-newsletter-signup__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="ai-newsletter-signup__form-wrapper">
        {% form 'contact' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ai-newsletter-signup__form-container">
            <input
              type="email"
              name="contact[email]"
              class="ai-newsletter-signup__input"
              placeholder="{{ section.settings.email_placeholder }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-newsletter-signup-error"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-newsletter-signup-success"
              {% endif %}required
            >
            <button
              type="submit"
              class="ai-newsletter-signup__button"
              aria-label="Subscribe to newsletter"
            >
              <span class="ai-newsletter-signup__button-icon">
              {{- 'new-arrow.svg' | inline_asset_content -}}
            </span>
            </button>
          </div>

          {% if form.errors %}
            <div
              id="ai-newsletter-signup-error"
              class="ai-newsletter-signup__error"
            >
              {{ form.errors.messages.email }}
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div
              id="ai-newsletter-signup-success"
              class="ai-newsletter-signup__success"
            >
              {{ section.settings.success_message }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="ai-newsletter-signup__logo-wrapper">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ section.settings.logo.alt | escape }}"
          class="ai-newsletter-signup__logo"
          loading="lazy"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-newsletter-signup__logo-placeholder">
          {{ 'image' | placeholder_svg_tag }}<div class="ai-newsletter-signup__empty-state">
            Add your logo
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</newsletter-signup>

<script>
  (function() {
    class NewsletterSignup extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        this.input = this.querySelector('.ai-newsletter-signup__input');
        if (this.form && this.input) {
          this.setupFormValidation();
        }
      }

      setupFormValidation() {
        this.form.addEventListener('submit', (event) => {
          const email = this.input.value.trim();
          
          if (!this.isValidEmail(email)) {
            event.preventDefault();
            this.showError('Please enter a valid email address');
            return;
          }
        });

        this.input.addEventListener('input', () => {
          this.clearMessages();
        });
      }

      isValidEmail(email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
      }

      showError(message) {
        this.clearMessages();
        const errorDiv = document.createElement('div');
        errorDiv.className = 'ai-newsletter-signup__error';
        errorDiv.textContent = message;
        this.querySelector('.ai-newsletter-signup__form-wrapper').appendChild(errorDiv);
      }

      clearMessages() {
        const existingError = this.querySelector('.ai-newsletter-signup__error:not([id])');
        if (existingError) {
          existingError.remove();
        }
      }
    }

    customElements.define('newsletter-signup', NewsletterSignup);
  })();
</script>

{% schema %}
