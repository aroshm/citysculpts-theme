{% doc %}
  @prompt
    Create a responsive newsletter signup section with cream background (#F3F2EE). Include heading "Join the CITYSCULPS Community", descriptive text about email subscription, email input with arrow submit button, and logo image from https://cdn.shopify.com/s/files/1/0923/2059/6310/files/Group_8.svg

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-newsletter-signup-{{ ai_gen_id }} {
    background-color: #F3F2EE;
    padding: 60px 20px;
    width: 100%;
  }

  .ai-newsletter-signup__container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-newsletter-signup__logo-{{ ai_gen_id }} {
    margin-bottom: 32px;
  }

  .ai-newsletter-signup__logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-newsletter-signup__heading-{{ ai_gen_id }} {
    font-size: 23px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .ai-newsletter-signup__heading-{{ ai_gen_id }} {
      font-size: 35px;
    }
  }

  @media (min-width: 1200px) {
    .ai-newsletter-signup__heading-{{ ai_gen_id }} {
      font-size: 43px;
    }
  }

  .ai-newsletter-signup__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 32px 0;
    line-height: 1.5;
    max-width: 600px;margin-left: auto;
    margin-right: auto;
  }

  .ai-newsletter-signup__form-wrapper-{{ ai_gen_id }} {
    max-width: 500px;
    margin: 0 auto;
  }

  .ai-newsletter-signup__form-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    border-radius: {{ block.settings.input_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);}

  .ai-newsletter-signup__input-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 20px;
    border: none;
    font-size: 16px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    outline: none;
  }

  .ai-newsletter-signup__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    min-width: 60px;
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-newsletter-signup__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-newsletter-signup__success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 16px;font-size: 14px;}

  .ai-newsletter-signup__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 16px;
    font-size: 14px;
  }

  @media screen and (max-width: 768px) {
    .ai-newsletter-signup-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-newsletter-signup__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-newsletter-signup__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
      margin-bottom: 24px;
    }

    .ai-newsletter-signup__form-{{ ai_gen_id }} {
      flex-direction: column;
      border-radius: {{ block.settings.input_border_radius }}px;
    }

    .ai-newsletter-signup__input-{{ ai_gen_id }} {
      border-radius: {{ block.settings.input_border_radius }}px {{ block.settings.input_border_radius }}px 0 0;
    }

    .ai-newsletter-signup__button-{{ ai_gen_id }} {
      border-radius: 0 0 {{ block.settings.input_border_radius }}px {{ block.settings.input_border_radius }}px;
      padding: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-newsletter-signup__logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-newsletter-signup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter-signup__container-{{ ai_gen_id }}">
    {% if block.settings.show_logo %}
      <div class="ai-newsletter-signup__logo-{{ ai_gen_id }}">
        <img
          src="https://cdn.shopify.com/s/files/1/0923/2059/6310/files/Group_8.svg"
          alt="CITYSCULPS Logo"
          loading="lazy"
        >
      </div>
    {% endif %}

    <h2 class="ai-newsletter-signup__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>

    {% if block.settings.description != blank %}
      <div class="ai-newsletter-signup__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="ai-newsletter-signup__form-wrapper-{{ ai_gen_id }}">
      {% form 'customer', class: 'ai-newsletter-signup__form-content' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="ai-newsletter-signup__form-{{ ai_gen_id }}">
          <input
            type="email"
            name="contact[email]"
            class="ai-newsletter-signup__input-{{ ai_gen_id }}"
            value="{{ form.email }}"
            placeholder="{{ block.settings.email_placeholder }}"
            aria-label="Email address"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"aria-describedby="ai-newsletter-signup-error-{{ ai_gen_id }}"
            {% endif %}
            {% if form.posted_successfully? %}
              aria-describedby="ai-newsletter-signup-success-{{ ai_gen_id }}"
            {% endif %}required
          >
          <button
            type="submit"
            class="ai-newsletter-signup__button-{{ ai_gen_id }}"
            aria-label="Subscribe to newsletter"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>

        {% if form.errors %}
          <div
            id="ai-newsletter-signup-error-{{ ai_gen_id }}"
            class="ai-newsletter-signup__error-{{ ai_gen_id }}">
            {{ form.errors.messages.email }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <div
            id="ai-newsletter-signup-success-{{ ai_gen_id }}"
            class="ai-newsletter-signup__success-{{ ai_gen_id }}"
          >
            {{ block.settings.success_message }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the CITYSCULPS Community"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Stay updated with our latest collections, exclusive offers, and design inspiration delivered straight to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing! Welcome to the CITYSCULPS community."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Input background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "input_placeholder_color",
      "label": "Input placeholder",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success message",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error message",
      "default": "#D82C0D"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ],
  "tag": null
}
{% endschema %}