{% doc %}
  @prompt
    i want my menue to be half in the right side half in the left side and the logo in the centre

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-menu-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    position: relative;
    width: 100%;
  }

  .ai-split-menu__left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_spacing }}px;
    flex: 1;
    justify-content: flex-start;
  }

  .ai-split-menu__center-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .ai-split-menu__right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_spacing }}px;
    flex: 1;
    justify-content: flex-end;
  }

  .ai-split-menu__logo-{{ ai_gen_id }} {
    display: block;
    line-height: 0;
  }

  .ai-split-menu__logo-{{ ai_gen_id }} img {
    height: {{ block.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
  }

  .ai-split-menu__logo-placeholder-{{ ai_gen_id }} {
    height: {{ block.settings.logo_height }}px;
    width: 120px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-split-menu__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 30px;
    opacity: 0.5;
  }

  .ai-split-menu__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    padding: 8px 12px;
    border-radius: {{ block.settings.link_border_radius }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-split-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.link_hover_background }};
  }

  .ai-split-menu__mobile-toggle-{{ ai_gen_id }} {
    display: none;background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-split-menu__mobile-menu-{{ ai_gen_id }} {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: {{ block.settings.background_color }};
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    z-index: 10;
    padding: 20px;
  }

  .ai-split-menu__mobile-menu-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-split-menu__mobile-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media screen and (max-width: 768px) {
    .ai-split-menu__left-{{ ai_gen_id }},
    .ai-split-menu__right-{{ ai_gen_id }} {
      display: none;
    }

    .ai-split-menu__mobile-toggle-{{ ai_gen_id }} {
      display: block;
    }

    .ai-split-menu__center-{{ ai_gen_id }} {
      position: static;
      transform: none;
      flex: 1;
      display: flex;
      justify-content: center;
    }

    .ai-split-menu-{{ ai_gen_id }} {
      justify-content: space-between;
    }
  }
{% endstyle %}

<split-menu-{{ ai_gen_id }} class="ai-split-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav class="ai-split-menu__left-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign link_key = 'left_link_' | append: i
        assign text_key = 'left_text_' | append: i
        assign link_url = block.settings[link_key]
        assign link_text = block.settings[text_key]
      %}
      {% if link_text != blank %}
        <a href="{{ link_url | default: '#' }}" class="ai-split-menu__link-{{ ai_gen_id }}">
          {{ link_text }}
        </a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="ai-split-menu__center-{{ ai_gen_id }}">
    <a href="{{ routes.root_url }}" class="ai-split-menu__logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: height: block.settings.logo_height }}"
          alt="{{ shop.name }}"
          width="auto"
          height="{{ block.settings.logo_height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-split-menu__logo-placeholder-{{ ai_gen_id }}">
          {{ 'logo' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </a></div>

  <nav class="ai-split-menu__right-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign link_key = 'right_link_' | append: i
        assign text_key = 'right_text_' | append: i
        assign link_url = block.settings[link_key]
        assign link_text = block.settings[text_key]
      %}
      {% if link_text != blank %}
        <a href="{{ link_url | default: '#' }}" class="ai-split-menu__link-{{ ai_gen_id }}">
          {{ link_text }}
        </a>
      {% endif %}
    {% endfor %}
  </nav>

  <button class="ai-split-menu__mobile-toggle-{{ ai_gen_id }}" aria-label="Toggle menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <div class="ai-split-menu__mobile-menu-{{ ai_gen_id }}">
    <div class="ai-split-menu__mobile-links-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign link_key = 'left_link_' | append: i
          assign text_key = 'left_text_' | append: i
          assign link_url = block.settings[link_key]
          assign link_text = block.settings[text_key]
        %}
        {% if link_text != blank %}
          <a href="{{ link_url | default: '#' }}" class="ai-split-menu__link-{{ ai_gen_id }}">
            {{ link_text }}
          </a>
        {% endif %}
      {% endfor %}
      {% for i in (1..4) %}
        {% liquid
          assign link_key = 'right_link_' | append: i
          assign text_key = 'right_text_' | append: i
          assign link_url = block.settings[link_key]
          assign link_text = block.settings[text_key]
        %}
        {% if link_text != blank %}
          <a href="{{ link_url | default: '#' }}" class="ai-split-menu__link-{{ ai_gen_id }}">
            {{ link_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</split-menu-{{ ai_gen_id }}><script>
  (function() {
    class SplitMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.mobileToggle = this.querySelector('.ai-split-menu__mobile-toggle-{{ ai_gen_id }}');
        this.mobileMenu = this.querySelector('.ai-split-menu__mobile-menu-{{ ai_gen_id }}');
        if (this.mobileToggle && this.mobileMenu) {
          this.mobileToggle.addEventListener('click', () => {
            this.mobileMenu.classList.toggle('active');
          });document.addEventListener('click', (event) => {
            if (!this.contains(event.target)) {
              this.mobileMenu.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('split-menu-{{ ai_gen_id }}', SplitMenu{{ ai_gen_id }});
  })();
</script>

