{% doc %}
  @prompt
    Create a responsive testimonial section using the background image https://cdn.shopify.com/s/files/1/0923/2059/6310/files/Frame_177.svg?v=1756493652. Include proper responsive design with appropriate font sizes for desktop and mobile, flexible layout that adapts to different screen sizes, and ensure the Canela font and decorative background work perfectly on all devices. Add customizable testimonial text and author fields., Clean this This product has completely transformed my business. The quality and service are exceptional., This product has completely transformed my business. The quality and service are exceptional. i dont wont this sentence to be in my blok, i sont wont  Allan Lokos to be in this section, shorten content wight and adapt mobail and besktop, no change the siziz adapt to mobail and desktop i see only half of the picture, and change layout size from the top and the bottom shorten them

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-section-{{ ai_gen_id }} {
    padding: {{ block.settings.top_padding_desktop }}px 0 {{ block.settings.bottom_padding_desktop }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-testimonial-content-{{ ai_gen_id }} {
    border-top: 1px solid #000;
    margin: 0 auto;
    padding: 64px 15px 110px 15px;
  }

  .testmonial-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-testimonial-quote-{{ ai_gen_id }} {
    font-family: 'Canela-regular';
    font-size: 23px;
    margin: 0 0 43px;
    max-width: 800px;
    line-height: 1.48;
    text-align: center;
    letter-spacing: 2.5px;
  }

  @media (min-width: 768px) {
    .ai-testimonial-quote-{{ ai_gen_id }} {
      font-size: 35px;
    }
  }

  @media (min-width: 1200px) {
    .ai-testimonial-quote-{{ ai_gen_id }} {
      font-size: 35px;
    }
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    font-family: 'Euclid-medium';
    font-size: 12px;
    letter-spacing: 1.3px;
    margin: 0;
  }

  .feature-highlight {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: space-between;
    margin-top: 33px;
    max-width: 1265px;
    margin-inline: auto;
  }

  .feature-hightlight-item {
    align-items: flex-start;
    display: flex;
    flex: 1;
    justify-content: flex-start;
    gap: 24px;
    padding-inline: 15px;
  }

  .feature-hightlight-item-heading {
    font-family: 'Canela-regular';
    font-size: 24px;
    line-height: 1.3;
    margin: 0 0 24px;
  }

  .feature-hightlight-item-text {
    font-family: 'Euclid-regular';
    font-size: 16px;
  }

  @media screen and (min-width:768px) {
    .feature-highlight {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .feature-hightlight-item {
      max-width: 50%;
    }
  }

  @media screen and (max-width:768px) {
    .ai-testimonial-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile }}px 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-testimonial-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile | times: 0.8 }}px 15px;
    }
  }
{% endstyle %}
 
<div class="ai-testimonial-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-content-{{ ai_gen_id }}">
    <div class="testmonial-wrapper">
      {% if block.settings.testimonial_text != blank %}
        <p class="ai-testimonial-quote-{{ ai_gen_id }}">
          "{{ block.settings.testimonial_text }}"
        </p>
      {% endif %}
      
      {% if block.settings.author_name != blank %}
        <p class="ai-testimonial-author-{{ ai_gen_id }}">
          {{ block.settings.author_name }}
        </p>
      {% endif %}
    </div>

    <div class="feature-highlight">
    <div class="feature-hightlight-item">
      <img src="{{ block.settings.feature_icon_one | image_url: width: 40 }}" alt="{{ block.settings.feature_heading_one }}" loading="lazy">
      <div class="feature-text-wrapper">
        <p class="feature-hightlight-item-heading">{{ block.settings.feature_heading_one }}</p>
        <p class="feature-hightlight-item-text">{{ block.settings.feature_text_one }}</p>
      </div>
    </div>
    <div class="feature-hightlight-item">
      <img src="{{ block.settings.feature_icon_two | image_url: width: 40 }}" alt="{{ block.settings.feature_heading_two }}" loading="lazy">
      <div class="feature-text-wrapper">
        <p class="feature-hightlight-item-heading">{{ block.settings.feature_heading_two }}</p>
        <p class="feature-hightlight-item-text">{{ block.settings.feature_text_two }}</p>
      </div>
    </div>
    <div class="feature-hightlight-item">
      <img src="{{ block.settings.feature_icon_three | image_url: width: 40 }}" alt="{{ block.settings.feature_heading_three }}" loading="lazy">
      <div class="feature-text-wrapper">
        <p class="feature-hightlight-item-heading">{{ block.settings.feature_heading_three }}</p>
        <p class="feature-hightlight-item-text">{{ block.settings.feature_text_three }}</p>
      </div>
    </div>
  </div>
  </div>
</div>

