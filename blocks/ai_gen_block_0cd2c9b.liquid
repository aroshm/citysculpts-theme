      "label": "Feature Heading One"
    },
    {
      "type": "text",
      "id": "feature_text_one",
      "label": "Feature Text One"
    },
    {
      "type": "image_picker",
      "id": "feature_icon_two",
      "label": "Feature Icon Two"
    },
    {
      "type": "text",
      "id": "feature_heading_two",
      "label": "Feature Heading Two"
    },
    {
      "type": "text",
      "id": "feature_text_two",
      "label": "Feature Text Two"
    },
    {
      "type": "image_picker",
      "id": "feature_icon_three",
