{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-simple-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-simple-header-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-start;
  }

  .ai-simple-header-center-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 00 auto;
    margin: 0 {{ block.settings.logo_margin }}px;
  }

  .ai-simple-header-right-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex: 1;
    justify-content: flex-end;gap: {{ block.settings.menu_spacing }}px;
  }

  .ai-simple-header-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-simple-header-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 4px;}

  .ai-simple-header-logo-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    opacity: 0.5;
  }

  .ai-simple-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.menu_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-simple-header-nav-item-{{ ai_gen_id }} {
    margin: 0;
    position: relative;
  }

  .ai-simple-header-nav-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_font_size }}px;
    font-weight: {{ block.settings.menu_font_weight }};
    padding: 8px 0;
    transition: color 0.3s ease;
    white-space: nowrap;
    display: block;
  }

  .ai-simple-header-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-simple-header-dropdown-{{ ai_gen_id }} {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 100;
    padding: 8px 0;
  }

  .ai-simple-header-nav-item-{{ ai_gen_id }}:hover .ai-simple-header-dropdown-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ai-simple-header-dropdown-link-{{ ai_gen_id }} {
    display: block;
    padding: 8px 16px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_font_size | times: 0.9 }}px;
    transition: background-color 0.3s ease, color 0.3s ease;}

  .ai-simple-header-dropdown-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dropdown_hover_bg }};
    color: {{ block.settings.text_hover_color }};
  }

  .ai-simple-header-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-simple-header-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    text-decoration: none;
    transition: color 0.3s ease;
    position: relative;
  }

  .ai-simple-header-icon-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-simple-header-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.8 }}px;
    height: {{ block.settings.icon_size | times: 0.8 }}px;
  }

  .ai-simple-header-cart-count-{{ ai_gen_id }} {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: {{ block.settings.cart_count_bg }};
    color: {{ block.settings.cart_count_text }};
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    min-width: 18px;
  }

  @media screen and (max-width: 1024px) {
    .ai-simple-header-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.menu_spacing | times: 0.8 }}px;
    }

    .ai-simple-header-nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.menu_font_size | times: 0.9 }}px;
    }

    .ai-simple-header-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.9 }}px;
    }

    .ai-simple-header-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.9 }}px;
      height: 54px;
    }

    .ai-simple-header-icons-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-simple-header-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-simple-header-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.menu_spacing | times: 0.6 }}px;
    }

    .ai-simple-header-nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.menu_font_size | times: 0.8 }}px;
    }

    .ai-simple-header-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-simple-header-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
      height: 48px;
    }

    .ai-simple-header-center-{{ ai_gen_id }} {
      margin: 0 {{ block.settings.logo_margin | times: 0.5 }}px;
    }

    .ai-simple-header-icons-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.6 }}px;
    }

    .ai-simple-header-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-simple-header-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
      height: {{ block.settings.icon_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-simple-header-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.menu_spacing | times: 0.4 }}px;
    }

    .ai-simple-header-nav-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.menu_font_size | times: 0.7 }}px;
    }

    .ai-simple-header-icons-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.4 }}px;
    }
  }
{% endstyle %}<header class="ai-simple-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-simple-header-left-{{ ai_gen_id }}">
    <nav role="navigation">
      <ul class="ai-simple-header-nav-{{ ai_gen_id }}">
        {% if block.settings.left_menu_1 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.left_menu_1_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.left_menu_1 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.left_menu_2 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.left_menu_2_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.left_menu_2 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.left_menu_3 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.left_menu_3_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.left_menu_3 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.left_menu_4 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.left_menu_4_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.left_menu_4 }}
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  </div>

  <div class="ai-simple-header-center-{{ ai_gen_id }}"><a href="{{ routes.root_url }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="ai-simple-header-logo-{{ ai_gen_id }}"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"loading="lazy"
        >
      {% else %}
        <div class="ai-simple-header-logo-placeholder-{{ ai_gen_id }}">
          {{'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </a>
  </div>

  <div class="ai-simple-header-right-{{ ai_gen_id }}">
    <nav role="navigation">
      <ul class="ai-simple-header-nav-{{ ai_gen_id }}">
        {% if block.settings.right_menu_1 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.right_menu_1_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.right_menu_1 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.right_menu_2 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.right_menu_2_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.right_menu_2 }}
            </a>
          </li>
        {% endif %}
        {% if block.settings.right_menu_3 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.right_menu_3_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.right_menu_3 }}
            </a>{% if block.settings.right_menu_3_sub_1 != blank or block.settings.right_menu_3_sub_2 != blank %}
              <div class="ai-simple-header-dropdown-{{ ai_gen_id }}">
                {% if block.settings.right_menu_3_sub_1 != blank %}
                  <a href="{{ block.settings.right_menu_3_sub_1_link }}" class="ai-simple-header-dropdown-link-{{ ai_gen_id }}">
                    {{ block.settings.right_menu_3_sub_1 }}
                  </a>
                {% endif %}
                {% if block.settings.right_menu_3_sub_2 != blank %}
                  <a href="{{ block.settings.right_menu_3_sub_2_link }}" class="ai-simple-header-dropdown-link-{{ ai_gen_id }}">
                    {{ block.settings.right_menu_3_sub_2 }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </li>
        {% endif %}
        {% if block.settings.right_menu_4 != blank %}
          <li class="ai-simple-header-nav-item-{{ ai_gen_id }}">
            <a href="{{ block.settings.right_menu_4_link }}" class="ai-simple-header-nav-link-{{ ai_gen_id }}">
              {{ block.settings.right_menu_4 }}
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>

    <div class="ai-simple-header-icons-{{ ai_gen_id }}">
      <a href="{{ routes.search_url }}" class="ai-simple-header-icon-{{ ai_gen_id }}" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="ai-simple-header-icon-{{ ai_gen_id }}" aria-label="Shopping bag">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="m16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="ai-simple-header-cart-count-{{ ai_gen_id }}">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

