    "custom_faq_TTKAeT": {
      "type": "custom-faq",
      "blocks": {
        "faq_main_yngejM": {
          "type": "faq_main",
          "settings": {
            "main_question": "Ordering & Pricing",
            "main_answer": "",
            "sub_question_1": "What does a 3D house print cost?",
            "sub_answer_1": "Our 3D house prints start at $300 USD. Final pricing depends on the size, complexity, and framing options you choose.",
            "sub_question_2": "What sizes are available?",
            "sub_answer_2": "We offer multiple size options to fit your space and budget. Contact us for specific dimensions and pricing details.",
            "sub_question_3": "How long does delivery take?",
            "sub_answer_3": "The total production and delivery time is 1-4 weeks from the moment we receive your photos and confirm your order."
          }
        },
        "faq_main_nJrEWg": {
          "type": "faq_main",
          "settings": {
            "main_question": "Photos & Requirements",
            "main_answer": "What kind of photos do you need?We need high-quality, clear photos of your house's front facade taken from multiple angles. The photos should show good depth, architectural details, and the relief of the building. Natural daylight photos work best.How many photos should I send?Upload at least one main photo through our website, but we recommend sending 3-5 additional photos via email to capture all the important details and angles of your home.What if I don't have good photos of my house?If you need time to take better photos or don't currently have access to the building, consider our gift card option. This allows you to give the gift now and submit photos later.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        },
        "faq_main_6eraCq": {
          "type": "faq_main",
          "settings": {
            "main_question": "Production Process",
            "main_answer": "How do you create the 3D model?Based on your photos, our designers create a detailed digital 3D model of your house. Once you approve the design, we print it using high-quality 3D printing technology with sustainable PLA material.What material is used for printing?We use PLA (Polylactic Acid), a durable and eco-friendly material made from renewable plant-based resources. It's biodegradable and considered a sustainable alternative to traditional plastics.Can I see the design before it's printed?Yes! We'll show you the digital 3D model for your approval before we begin the printing process.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        },
        "faq_main_qbjdde": {
          "type": "faq_main",
          "settings": {
            "main_question": "Customization & Details",
            "main_answer": "What details can you capture?We can recreate architectural features like windows, doors, rooflines, porches, decorative trim, textures, and landscaping elements. The more detailed your photos, the more accurately we can reproduce these features.Can you print buildings other than houses?Absolutely! We can create 3D prints of schools, universities, vacation homes, office buildings, churches, or any special building that holds meaning for you.Do you offer framing options?Yes, we offer professional framing in elegant black frames with clean matting for larger prints. Smaller prints can be ordered without frames as standalone pieces.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        },
        "faq_main_4hK7fg": {
          "type": "faq_main",
          "settings": {
            "main_question": "Shipping & Delivery",
            "main_answer": "How is the 3D print packaged?We carefully package each 3D house print to ensure it arrives safely. Framed pieces receive extra protection during shipping.Do you ship internationally?Please contact us for international shipping options and rates.What if my 3D print arrives damaged?We take great care in packaging, but if your print arrives damaged, contact us immediately and we'll work to resolve the issue quickly.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        },
        "faq_main_9tMNRh": {
          "type": "faq_main",
          "settings": {
            "main_question": "Gift Options",
            "main_answer": "Is this a good gift idea?3D house prints make exceptional gifts for housewarmings, graduations, anniversaries, or anyone who has a special connection to a particular building. They're perfect for celebrating new homes or commemorating childhood houses.Do you offer gift certificates?Yes! Our gift cards are perfect when you want to give this unique present but need time for the recipient to provide photos. Gift cards can be delivered quickly for last-minute gifts.Can I surprise someone with their house?You can, but you'll need access to good photos of their home's facade. Make sure you can get clear, detailed photos without spoiling the surprise.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        },
        "faq_main_wDgr47": {
          "type": "faq_main",
          "settings": {
            "main_question": "Other Services",
            "main_answer": "Do you offer other types of house art?In addition to 3D prints, we also create hand-drawn illustrations of houses. Check our website for more artistic options to commemorate your special building.Have a question not listed here?Contact us directly - we're happy to discuss your specific needs and help create the perfect 3D representation of your special place.",
            "sub_question_1": "",
            "sub_answer_1": "",
            "sub_question_2": "",
            "sub_answer_2": "",
            "sub_question_3": "",
            "sub_answer_3": ""
          }
        }
      },
