        "custom_liquid": "<style>\n  .custom-form-wrapper {\n    max-width: 720px;\n    margin: 40px auto; /* Էջում կենտրոնացված */\n    padding: 30px 40px;\n    background: #fff;\n    border-radius: 10px;\n    box-shadow: 0 6px 20px rgba(0,0,0,0.1);\n    box-sizing: border-box;\n  }\n  .custom-form-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 22px 30px;\n  }\n  label {\n    font-weight: 600;\n    color: #333;\n    font-size: 0.9rem;\n    text-transform: uppercase;\n    letter-spacing: 0.03em;\n    margin-bottom: 6px;\n    display: block;\n  }\n  input[type=\"text\"],\n  input[type=\"email\"],\n  input[type=\"tel\"],\n  select,\n  input[type=\"file\"] {\n    width: 100%;\n    padding: 12px 14px;\n    border: 1.5px solid #ccc;\n    border-radius: 6px;\n    font-size: 1rem;\n    transition: border-color 0.25s ease;\n    box-sizing: border-box;\n  }\n  input[type=\"text\"]:focus,\n  input[type=\"email\"]:focus,\n  input[type=\"tel\"]:focus,\n  select:focus,\n  input[type=\"file\"]:focus {\n    border-color: #007bff;\n    outline: none;\n  }\n  select {\n    appearance: none;\n    background: url(\"data:image/svg+xml;charset=US-ASCII,%3csvg%20width%3d'10'%20height%3d'7'%20viewBox%3d'0%200%2010%207'%20xmlns%3d'http%3a//www.w3.org/2000/svg'%3e%3cpath%20d%3d'M0%200l5%207%205-7z'%20fill%3d'%23666'/%3e%3c/svg%3e\") no-repeat right 12px center;\n    background-size: 10px 7px;\n    cursor: pointer;\n  }\n  .full-width {\n    grid-column: 1 / -1;\n  }\n  .file-upload-wrapper {\n    border: 2px dashed #ccc;\n    padding: 30px;\n    text-align: center;\n    color: #666;\n    font-size: 0.95rem;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: border-color 0.3s ease;\n    position: relative;\n  }\n  .file-upload-wrapper:hover {\n    border-color: #007bff;\n    color: #007bff;\n  }\n  input[type=\"file\"] {\n    opacity: 0;\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    top: 0; left: 0;\n    cursor: pointer;\n  }\n  .file-upload-label {\n    display: inline-block;\n    width: 100%;\n    height: 60px;\n    line-height: 60px;\n    position: relative;\n  }\n  button {\n    margin-top: 28px;\n    background-color: #007bff;\n    color: white;\n    padding: 14px 0;\n    font-size: 1.1rem;\n    border: none;\n    border-radius: 8px;\n    width: 100%;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n  }\n  button:hover {\n    background-color: #0056b3;\n  }\n  hr {\n    border: none;\n    border-top: 1px solid #eee;\n    margin: 20px 0 30px 0;\n  }\n  @media (max-width: 768px) {\n    .custom-form-grid {\n      grid-template-columns: 1fr;\n      gap: 18px 0;\n    }\n  }\n</style>\n\n<div class=\"custom-form-wrapper\">\n  <form action=\"https://formspree.io/f/{your_form_id}\" method=\"POST\" enctype=\"multipart/form-data\" novalidate>\n    <div class=\"custom-form-grid\">\n      <div>\n        <label for=\"first_name\">First Name *</label>\n        <input type=\"text\" id=\"first_name\" name=\"first_name\" required placeholder=\"Rehan\">\n      </div>\n      <div>\n        <label for=\"last_name\">Last Name *</label>\n        <input type=\"text\" id=\"last_name\" name=\"last_name\" required placeholder=\"Yaseen\">\n      </div>\n\n      <div>\n        <label for=\"email\">Email *</label>\n        <input type=\"email\" id=\"email\" name=\"_replyto\" required placeholder=\"user123@gmail.com\">\n      </div>\n      <div>\n        <label for=\"phone\">Phone Number *</label>\n        <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"+1 123 238 488\">\n      </div>\n\n      <div>\n        <label for=\"country\">Your Country *</label>\n        <select id=\"country\" name=\"country\" required>\n          <option value=\"\" disabled selected>Country</option>\n          <option>United States</option>\n          <option>Canada</option>\n          <option>Armenia</option>\n          <option>United Kingdom</option>\n          <option>France</option>\n        </select>\n      </div>\n      <div>\n        <label for=\"city\">Your City *</label>\n        <select id=\"city\" name=\"city\" required>\n          <option value=\"\" disabled selected>City</option>\n          <option>New York</option>\n          <option>Los Angeles</option>\n          <option>Yerevan</option>\n          <option>London</option>\n          <option>Paris</option>\n        </select>\n      </div>\n\n      <div>\n        <label for=\"street_address\">Street Address *</label>\n        <input type=\"text\" id=\"street_address\" name=\"street_address\" required placeholder=\"Street address\">\n      </div>\n      <div>\n        <label for=\"postal_code\">Postal Code *</label>\n        <input type=\"text\" id=\"postal_code\" name=\"postal_code\" required placeholder=\"12456\">\n      </div>\n\n      <div class=\"full-width\">\n        <hr>\n        <label for=\"custom_country\">Country of the City *</label>\n        <select id=\"custom_country\" name=\"custom_country\" required>\n          <option value=\"\" disabled selected>United States</option>\n          <option>United States</option>\n          <option>Canada</option>\n          <option>Armenia</option>\n        </select>\n      </div>\n\n      <div class=\"full-width\">\n        <label for=\"custom_city\">City/State *</label>\n        <select id=\"custom_city\" name=\"custom_city\" required>\n          <option value=\"\" disabled selected>New York</option>\n          <option>New York</option>\n          <option>Los Angeles</option>\n          <option>Yerevan</option>\n        </select>\n      </div>\n\n      <div class=\"full-width\">\n        <label for=\"coordinates\">Select the Coordinates of the Area *</label>\n        <input type=\"text\" id=\"coordinates\" name=\"coordinates\" placeholder=\"00°00'00&quot;N , 00°00'00&quot;E\" required>\n      </div>\n\n      <div class=\"full-width\">\n        <label>Attach Related Images of the Area *</label>\n        <div class=\"file-upload-wrapper\" tabindex=\"0\">\n          <label for=\"image\" class=\"file-upload-label\">\n            Upload Image\n            <input type=\"file\" id=\"image\" name=\"image\" accept=\"image/*\" required>\n          </label>\n          <p style=\"margin-top: 8px; font-size: 0.85rem; color: #999;\">\n            Browse or drag & drop the image of related images\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <button type=\"submit\">Order now for $300</button>\n  </form>\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
